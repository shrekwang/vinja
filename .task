    class ProjectTreeRootSelector(object):
        @staticmethod
        def runApp():
            from locate import QuickLocater, ProjectTreeRootContentManager
            mgr = ProjectTreeRootContentManager()
            if not mgr.entries:
                print("No roots configured. Add entries to ~/.vinja/ptree_roots.cfg")
                return
            QuickLocater.runApp(mgr)
